NODE_ENV=production
PORT=3001
LOGIN_FILE=/app/shared/login.json
COOKIE_SECURE=true
AUTH_SALT=replace-with-a-long-random-secret
LOGIN_MASTER_PASSWORD=replace-with-a-strong-emergency-password
DB_DRIVER=tedious
DB_SERVER=host.docker.internal,1433
DB_DATABASE=COSEC
DB_USER=replace-with-read-only-sql-user
DB_PASSWORD=replace-with-sql-password
DB_ENCRYPT=false
# Optional alternative to the DB_* values above:
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:db.example.com,1433;Database=COSEC;UID=...;PWD=...;TrustServerCertificate=Yes;
