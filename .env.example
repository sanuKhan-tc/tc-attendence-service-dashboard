DB_SERVER=localhost
DB_DATABASE=COSEC
PORT=3001
AUTH_SALT=replace-with-a-long-random-secret
# Optional emergency login for admin. Use a strong password and keep .env private.
LOGIN_MASTER_PASSWORD=
# Set true when HTTPS terminates in front of the app.
COOKIE_SECURE=false
VITE_LIVE_DATA_ENABLED=false
# Docker uses the host's TCP endpoint; local development can keep using localhost/shared memory.
DOCKER_DB_SERVER=host.docker.internal,1433
DOCKER_DB_DRIVER=tedious
# Set these for Docker SQL authentication:
# DOCKER_DB_USER=tc_attendance_reader
# DOCKER_DB_PASSWORD=YOUR_SQL_PASSWORD
DOCKER_DB_ENCRYPT=false
# Optional Docker override. Linux containers need SQL authentication when Windows integrated auth is unavailable.
# DOCKER_DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:host.docker.internal,1433;Database=COSEC;UID=YOUR_SQL_USER;PWD=YOUR_SQL_PASSWORD;TrustServerCertificate=Yes;
# Optional override when the server or driver differs:
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=COSEC;Trusted_Connection=Yes;TrustServerCertificate=Yes;
